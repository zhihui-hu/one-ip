# Copy to .env.docker. These values are read only at container startup.
# Direct access works without trusted proxies. Behind a reverse proxy, list only
# its immediate IP or dedicated CIDR and overwrite X-Forwarded-For/Proto there.
TRUSTED_PROXIES=
# Public URL visitors use, e.g. https://ip.example.com. Required behind an HTTPS
# proxy unless that proxy is trusted and sends X-Forwarded-Proto.
PUBLIC_ORIGIN=
# Set to true only when every trusted proxy forwards Cloudflare's
# CF-Connecting-IP and the origin accepts traffic from Cloudflare alone.
TRUST_CF_CONNECTING_IP=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
TURNSTILE_NONINTERACTIVE_SITE_KEY=
TURNSTILE_NONINTERACTIVE_SECRET=
TURNSTILE_NONINTERACTIVE_HOSTNAMES=
TIANDITU_TOKEN=

