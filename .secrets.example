# Optional: ipbot origin for IP data; defaults to the public https://api.ipbot.net.
IPBOT_API_URL=
# Optional: Origin sent to ipbot; must be on ipbot's PARTNER_DOMAINS whitelist
# (no session, no rate limits). Defaults to https://ip.huzhihui.com.
IPBOT_ORIGIN=

# Required for new Ping measurements; also enables verification experiences.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_HOSTNAMES=

# Optional: Tianditu browser map token. Missing or unavailable Tianditu falls back to OpenStreetMap.
TIANDITU_TOKEN=

# Optional second widget: configure its mode as Non-interactive in Cloudflare.
TURNSTILE_NONINTERACTIVE_SITE_KEY=
TURNSTILE_NONINTERACTIVE_SECRET=
TURNSTILE_NONINTERACTIVE_HOSTNAMES=
