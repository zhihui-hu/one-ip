# Docker 运行示例 / Docker run example:
# 复制为 `.env` 后填值，然后 `docker compose up -d --build`。
# Copy to `.env`, fill in values, then run `docker compose up -d --build`.
#
# 仅当需要“验证体验”入口时才填 Turnstile / reCAPTCHA；留空则入口自动隐藏。
# Only needed for the verification widgets; leave empty to hide those entries.

# 服务端口 / Port the container listens on (default 8787)
PORT=8787
# 监听地址，Docker 下保持 0.0.0.0 / Bind address, keep 0.0.0.0 under Docker
HOST=0.0.0.0

# --- Cloudflare Turnstile / Cloudflare Turnstile ---
# 站点 Key（前端公开）/ Site Key (public, used by the frontend)
TURNSTILE_SITE_KEY=
# 服务端 Secret（勿泄露）/ Server-side Secret (keep private)
TURNSTILE_SECRET=
# 允许的访问域名，逗号分隔，如 example.com / Allowed hostnames, comma-separated, e.g. example.com
TURNSTILE_HOSTNAMES=
# 第二个 Turnstile 组件（Non-interactive 模式，可选）/ Second widget (Non-interactive mode, optional)
TURNSTILE_NONINTERACTIVE_SITE_KEY=
TURNSTILE_NONINTERACTIVE_SECRET=
TURNSTILE_NONINTERACTIVE_HOSTNAMES=
# --- Google reCAPTCHA v3（评分型密钥）/ Google reCAPTCHA v3 (score-based keys) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_HOSTNAMES=
