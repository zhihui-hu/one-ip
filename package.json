{
  "name": "ip",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "version": "26.922.1906",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy --cwd deploy/pages",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm build && node scripts/build-server.mjs pages",
    "build:docker": "pnpm build && node scripts/build-server.mjs docker",
    "start": "node .output/server.mjs",
    "pages:dev": "wrangler pages dev --cwd deploy/pages",
    "worker:dev": "node scripts/worker-dev.mjs",
    "worker:types": "wrangler types",
    "test": "wrangler deploy --dry-run --env='' --outdir .worker-test && node --import ./tests/register-paths.mjs --test tests/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "browser:build": "node scripts/build-browser-diagnostics.mjs"
  },
  "dependencies": {
    "@cloudflare/speedtest": "1.14.2",
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "echarts": "6.1.0",
    "gsap": "3.15.0",
    "jotai": "3.0.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "nprogress": "0.2.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-liquid-glass-svg": "1.0.5",
    "react-router-dom": "7.18.4",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/nprogress": "0.2.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup": "4.64.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "description": "IP diagnostics SPA with Cloudflare Workers",
  "keywords": [
    "react",
    "vite",
    "spa",
    "shadcn-ui",
    "tanstack-query",
    "tanstack-table"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
