
# Ping protection and browser challenge playground. Never put secrets in VITE_* variables.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,ip.huzhihui.com

# Optional second widget: configure its mode as Non-interactive in Cloudflare.
TURNSTILE_NONINTERACTIVE_SITE_KEY=
TURNSTILE_NONINTERACTIVE_SECRET=
TURNSTILE_NONINTERACTIVE_HOSTNAMES=
